# PEMRIX Server-3 Deployment Environment Variables
# Copy this file to .env and fill in real values before running deploy-server-3.py.

# Server-3 is reached via the SSH alias defined in ~/.ssh/config (default: pegus-s3).
# No password is required if the alias uses ProxyJump + the correct identity file.
SERVER3_SSH_HOST=pegus-s3

# PEMRIX domain configuration
PEMRIX_DOMAIN=pemrix.com

# Optional overrides
# PEMRIX_DATA_DIR=/var/lib/pemrix
# PEMRIX_SOURCE_DIR=/opt/pemrix
# PEMRIX_TESTNET_MODE=true

# Cloudflare (used by cloudflare-setup.sh)
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
